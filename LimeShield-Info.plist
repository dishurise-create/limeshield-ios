	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.limeshield.LimeShield</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>limeshield</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
